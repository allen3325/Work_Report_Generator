# Report Generator - Environment Variables Example

# HackMD API Configuration
# Required: HACKMD_API_TOKEN
# Optional: HACKMD_API_URL (defaults to https://api.hackmd.io/v1)

HACKMD_API_TOKEN=your_hackmd_api_token_here
HACKMD_API_URL=https://api.hackmd.io/v1

# LLM API Keys and Models - Both API key and model are required based on your chosen provider

# For OpenAI provider
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.4-mini

# For Google Gemini provider
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# For Anthropic Claude provider
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-sonnet-5  # Required: e.g., claude-sonnet-5, claude-opus-4-8

# For OpenAI Compatible provider (e.g., vLLM, Ollama, LiteLLM)
OPENAI_COMPATIBLE_API_KEY=your_compatible_api_key_here  # Can be a dummy value (e.g., "empty") if not required by the server
OPENAI_COMPATIBLE_MODEL=your_model_name_here
OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1

# For Ollama Cloud provider
OLLAMA_CLOUD_API_KEY=your_ollama_cloud_api_key_here
OLLAMA_CLOUD_MODEL=minimax-m3  # e.g., minimax-m3, gpt-oss:120b

# For Claude Vertex AI (Anthropic on GCP Vertex AI) provider
CLAUDE_VERTEX_PROJECT_ID=your_gcp_project_id_here
CLAUDE_VERTEX_REGION=global  # Optional (defaults to global)
CLAUDE_VERTEX_MODEL=claude-sonnet-5  # Required: e.g. claude-3-5-sonnet@20240620 or claude-sonnet-5